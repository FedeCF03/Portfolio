@page "/not-found"
@inject FedePortfolio.Web.Services.SiteMetadata Meta

<PageTitle>404 — @Meta.Name</PageTitle>

<section class="not-found">
  <p class="not-found__code">404</p>
  <h1>Esta página no existe.</h1>
  <p>El enlace puede estar roto o el contenido se movió. Probá volver al inicio.</p>
  <a class="not-found__back" href="./">Volver al inicio <span aria-hidden="true">→</span></a>
</section>
